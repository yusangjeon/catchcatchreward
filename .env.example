# 비워두면 인메모리 저장소로 동작한다(개발·데모용, 서버 인스턴스 교체 시 초기화).
# Postgres 연결 문자열을 넣으면 영속 저장. Supabase 는 Project Settings → Database → Connection string(URI, Transaction pooler 6543) 값.
# 예: postgresql://postgres.xxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# 연결 후 관리자 /admin/db 에서 "스키마 적용 + 시드" 1회 (또는 pnpm db:migrate).
DATABASE_URL=

# 관리자(/admin) 로그인 키. 비우면 관리자 비활성. 로컬 QA 는 CCR_DEV_TOOLS=1 로 키 없이 열림
ADMIN_KEY=
# 개발 전용 도구(/api/dev/*, 키 없는 관리자). 배포에서는 설정하지 말 것
# CCR_DEV_TOOLS=1
