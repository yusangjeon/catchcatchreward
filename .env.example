# 비워두면 인메모리 저장소로 동작한다(개발·데모용, 서버 재시작 시 초기화).
# Supabase 프로젝트를 연결하면 아래 두 값을 채운다. 서비스 롤 키는 서버 전용이다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 일일 퀴즈 응답 한도 (기본 5)
QUIZ_DAILY_LIMIT=5

# 관리자(/admin) 로그인 키. 비우면 관리자 비활성. 로컬 QA 는 CCR_DEV_TOOLS=1 로 키 없이 열림
ADMIN_KEY=
# 개발 전용 도구(/api/dev/*, 키 없는 관리자). 배포에서는 설정하지 말 것
# CCR_DEV_TOOLS=1
