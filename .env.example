# 비워두면 인메모리 저장소로 동작한다(개발·데모용, 서버 인스턴스 교체 시 초기화).
# Postgres 연결 문자열을 넣으면 영속 저장. Supabase 는 Project Settings → Database → Connection string(URI, Transaction pooler 6543) 값.
# 예: postgresql://postgres.xxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# 연결 후 관리자 /admin/db 에서 "스키마 적용 + 시드" 1회 (또는 pnpm db:migrate).
DATABASE_URL=

# 관리자(/admin) 로그인 키. 비우면 관리자 비활성. 로컬 QA 는 CCR_DEV_TOOLS=1 로 키 없이 열림
ADMIN_KEY=
# 개발 전용 도구(/api/dev/*, 키 없는 관리자). 배포에서는 설정하지 말 것
# CCR_DEV_TOOLS=1

# 제휴 쇼핑 아웃링크(선택). 쿠팡 파트너스에서 발급한 링크를 넣으면 쇼핑적립의 쿠팡 CTA 가 그 링크로 나간다.
# COUPANG_PARTNERS_URL=https://link.coupang.com/a/xxxxx
# 쇼핑몰별 덮어쓰기: AFFILIATE_URL_<쇼핑몰ID 대문자> (예: AFFILIATE_URL_GMARKET=https://...)

# 웹푸시(선택). `pnpm push:keys` 로 1회 생성해 넣으면 /notifications 의 "푸시 알림 켜기"가 활성화된다.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Vercel Cron(매일 09:00 KST /api/push/cron) 인증. Vercel 이 자동 주입(Settings → Environment Variables 에 CRON_SECRET 추가)
# CRON_SECRET=

# 캐치미션 연동(선택). 참여 링크 베이스 URL — 앱이 ?uid=&mid= 를 붙여 연다. 없으면 "플레이스 방문하기" 참여 버튼이 미리보기 안내
# MISSION_PARTNER_URL=https://catchmission.example.com/m
# 캐치미션 서버 → POST /api/postback/mission 인증 키(Bearer 또는 ?key=). 없으면 포스트백 503(CCR_DEV_TOOLS=1 일 때만 무키 허용)
# POSTBACK_SECRET=
